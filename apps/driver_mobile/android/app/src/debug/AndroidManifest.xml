<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Loopback HTTP is permitted only in debug builds for local emulators. -->
    <application android:usesCleartextTraffic="true" android:label="AeroTrans Driver Demo" tools:replace="android:label,android:usesCleartextTraffic">
        <!-- Initialize Firebase explicitly after local service readiness checks. -->
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" android:authorities="${applicationId}.firebaseinitprovider" tools:node="remove" />
    </application>
</manifest>
