# Local emulators only. Root npm scripts supply these values automatically.
# Never put service-account credentials in local configuration.
AEROTRANS_ENV=local
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=demo-aerotrans-png2
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004
TIMEZONE=Pacific/Port_Moresby
CURRENCY=PGK
